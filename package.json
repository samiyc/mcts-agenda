{
  "name": "mcts-agenda",
  "version": "0.3.0",
  "private": true,
  "description": "Les emplois du temps d'un établissement scolaire : les contraintes, la recherche locale, et le replanning qui dérange le moins possible.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test --test-concurrency=4",
    "test:coverage": "node --test --test-concurrency=4 --experimental-test-coverage --test-coverage-include=src/** --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=90",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "types": "tsc -p .",
    "check": "npm run lint && npm run types && npm test",
    "prepare": "git config core.hooksPath .githooks",
    "compare": "node scripts/compare.js",
    "page": "node node_modules/mcts-commun/bin/serve.js 4805",
    "changelog": "node scripts/changelog.js",
    "bench": "node scripts/search-bench.js",
    "xhstt": "node scripts/xhstt-check.js"
  },
  "author": "Sami",
  "license": "UNLICENSED",
  "dependencies": {
    "mcts-commun": "file:../mcts-commun"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "typescript": "^5.9.3"
  }
}
